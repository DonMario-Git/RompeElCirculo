--- !u!1001 &706826555
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1908505702}
    m_Modifications:
    - target: {fileID: 2533430354450333569, guid: 21f4d456af99d0242bf24e4b98b53b09, type: 3}
      propertyPath: m_text
      value: "El Bot\xF3n Violeta es un mecanismo dise\xF1ado para brindar m\xE1s
        difusi\xF3n y cobertura a todas las personas que se sientan violentadas y
        necesiten apoyo. A trav\xE9s de este bot\xF3n, podr\xE1s denunciar situaciones
        de violencia y pedir ayuda de forma r\xE1pida y segura. \r\n\r\nAl usarlo,
        se abrir\xE1 un formulario en el micrositio de la estrategia Rompe el C\xEDrculo,
        donde podr\xE1s compartir tu caso. \n\nTu reporte llegar\xE1 de inmediato
        a las autoridades y equipos de apoyo correspondientes, quienes atender\xE1n
        tu situaci\xF3n con base en la informaci\xF3n que nos proporciones.\n\nBot\xF3n
        Violeta te mostrar\xE1 l\xEDneas de atenci\xF3n y canales de apoyo para que
        siempre tengas opciones de ayuda y acompa\xF1amiento. "
      objectReference: {fileID: 0}
