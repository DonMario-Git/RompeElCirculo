    - target: {fileID: 2533430354450333569, guid: 21f4d456af99d0242bf24e4b98b53b09, type: 3}
      propertyPath: m_text
      value: "La Violencia Basada en G\xE9nero (VGB) es cualquier acci\xF3n o comportamiento
        que cause da\xF1o o sufrimiento a una persona debido a su g\xE9nero, identidad
        de g\xE9nero, expresi\xF3n de g\xE9nero o caracter\xEDsticas asociadas con
        un g\xE9nero determinado. Esta violencia puede ser f\xEDsica, psicol\xF3gica,
        sexual, econ\xF3mica o simb\xF3lica, y puede ocurrir en cualquier \xE1mbito
        de la vida, como en la familia, el trabajo, la escuela o la comunidad."
      objectReference: {fileID: 0}
