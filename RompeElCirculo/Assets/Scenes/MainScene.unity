    - target: {fileID: 2533430354450333569, guid: 21f4d456af99d0242bf24e4b98b53b09, type: 3}
      propertyPath: m_text
      value: "Debes acudir si tus hijos est\xE1n siendo v\xEDctimas de violencia
        f\xEDsica, psicol\xF3gica o sexual, o si como madre v\xEDctima de violencia
        de g\xE9nero, sientes que la seguridad de tus hijos est\xE1 en peligro. Tambi\xE9n
        atienden casos de inasistencia alimentaria, abandono, trabajo infantil o
        cuando un menor es instrumentalizado por grupos armados o delincuencia."
      objectReference: {fileID: 0}
